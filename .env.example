# ====================================================================
# PhysioPro Anfrage-Management - Environment Variables (VORLAGE)
# --------------------------------------------------------------------
# Diese Datei NUR als Vorlage. Echte Werte werden im Netlify-Dashboard
# unter Site settings > Environment variables gesetzt, NICHT hier!
# ====================================================================

# Google Sheet ID (aus der Sheet-URL)
GOOGLE_SHEET_ID=DEINE_GOOGLE_SHEET_ID_HIER

# Google Service Account (kompletter JSON-String der Service-Account-Datei)
# Im Netlify-Dashboard als einzeiligen JSON-String einfuegen.
GOOGLE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}

# Node Environment
NODE_ENV=production

# ---- Microsoft Graph: Outlook-Entwürfe (draft-create.js) ----
# Neue Azure App "PhysioPro-Dashboard-Mailer", Mail.ReadWrite (Application)
MS_TENANT_ID=84c5926a-a7f0-4d30-bfe6-8d445df9a2ba
MS_DASHBOARD_CLIENT_ID=CLIENT_ID_DER_NEUEN_APP
MS_DASHBOARD_CLIENT_SECRET=CLIENT_SECRET_VALUE
MS_DASHBOARD_MAILBOX=info@physioproluebeck.de

# ---- Osteo-Termine (Tab in der To-Do-Spalte) ----
# Eigenes Google Sheet (Tab "Termine"), getrennt vom Anfrage-Sheet.
OSTEO_SHEET_ID=DEINE_OSTEO_SHEET_ID_HIER
OSTEO_GOOGLE_CLIENT_EMAIL=SERVICE_ACCOUNT@PROJEKT.iam.gserviceaccount.com
OSTEO_GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Microsoft Graph: echter Mailversand (Bestätigung + Erinnerungen).
# Eigene Azure App mit Mail.Send (Application) — NICHT dieselbe wie der
# Dashboard-Mailer oben (der hat nur Mail.ReadWrite für Entwürfe).
OSTEO_GRAPH_TENANT_ID=84c5926a-a7f0-4d30-bfe6-8d445df9a2ba
OSTEO_GRAPH_CLIENT_ID=CLIENT_ID_DER_OSTEO_MAILER_APP
OSTEO_GRAPH_CLIENT_SECRET=CLIENT_SECRET_VALUE
OSTEO_GRAPH_SENDER=info@physioproluebeck.de
